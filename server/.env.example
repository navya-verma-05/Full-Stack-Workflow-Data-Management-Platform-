NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/CHANGE_ME_DB_NAME
CLIENT_ORIGIN=http://localhost:5173

JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_ACCESS_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_RANDOM_REFRESH_SECRET_AT_LEAST_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

WEBHOOK_TOLERANCE_SECONDS=300
RETRY_MAX_ATTEMPTS=4
RETRY_POLL_INTERVAL_MS=2000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
WEBHOOK_RATE_LIMIT_MAX=1000

LOG_LEVEL=info

